<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/best_results"
    android:padding="24dp">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/br_vertical_line_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3"
        />

    <TextView
        android:id="@+id/tvLabelReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Czas Reakcji:"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/br_vertical_line_1"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/main_text_color"
        />

    <TextView
        android:id="@+id/tvScoreReaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="- ms"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvLabelReaction"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvLabelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pamięć Liczb (Rundy):"
        android:textColor="@color/main_text_color"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/tvScoreReaction"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"/>

    <TextView
        android:id="@+id/tvScoreNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvLabelNumber"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvLabelPicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pamięć Obrazkowa (Rundy):"
        android:textColor="@color/main_text_color"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/tvScoreNumber"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"/>

    <TextView
        android:id="@+id/tvScorePicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvLabelPicture"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>